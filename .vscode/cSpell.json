{
    "version": "0.2",
    "language": "en",
    "languageSettings": [
        {
            "languageId": "rust",
            "words": []
        }
    ],
    "dictionaryDefinitions": [
        {
            "name": "words",
            "path": "./dictionaries/words.txt",
            "addWords": true
        },
        {
            "name": "packages",
            "path": "./dictionaries/packages.txt"
        }
    ],
    "dictionaries": [
        "words",
        "packages"
    ],
    "ignorePaths": [
        "vendor/**",
        "THIRD-PARTY-NOTICES.yaml"
    ],
    "overrides": [
        {
            "filename": "**/.devin/rules/**/*.md",
            "words": [
                "defence",
                "ncols",
                "nums",
                "pathish",
                "rederives",
                "segs",
                "subdirs",
                "toks",
                "WRONLY"
            ]
        }
    ]
}